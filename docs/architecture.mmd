graph TD
    %% Define styles
    classDef ext fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef core fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;
    classDef ai fill:#e8f5e9,stroke:#388e3c,stroke-width:2px;

    %% External Systems
    PBX["PBX / SBC"]:::ext
    Grafana["Grafana"]:::ext
    Vault["HashiCorp Vault"]:::ext
    Redis["Redis (Session Store)"]:::ext
    AiEngine["AI Engine (STT/LLM/TTS)"]:::ext

    %% VBGW Subsystems
    subgraph "Voicebot Gateway (VBGW)"
        Endpoint["VoicebotEndpoint (PJSIP)"]:::core
        SessionMgr["SessionManager"]:::core
        Call["VoicebotCall"]:::core
        MediaPort["VoicebotMediaPort (RTP/VAD)"]:::core
        AiClient["VoicebotAiClient (gRPC)"]:::ai
        Metrics["MetricsExporter (Prometheus)"]:::core
    end

    %% Interactions
    PBX -- SIP INVITE --> Endpoint
    Endpoint -- TLS 1.3 --> Vault
    Endpoint -- creates --> Call
    Call -- registers with --> SessionMgr
    SessionMgr -- syncs state --> Redis
    Call -- manages --> MediaPort
    Call -- manages --> AiClient
    
    PBX -- RTP (G.711) --> MediaPort
    MediaPort -- audio chunks + VAD --> AiClient
    AiClient -- gRPC Bi-dir --> AiEngine
    AiEngine -- responses / audio --> AiClient
    AiClient -- injects audio --> MediaPort
    MediaPort -- RTP (G.711) --> PBX

    %% Observability
    Metrics -- scraped by --> Grafana
    Call -. reports metrics .-> Metrics
    AiClient -. reports latency .-> Metrics
